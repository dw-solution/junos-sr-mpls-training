#--------------------------------------------------------------------------
# STAGE 0 BASE: P2 (transit)
#--------------------------------------------------------------------------
set system host-name P2
set system time-zone UTC
set system root-authentication encrypted-password "$6$0OeCYa28gJMGyhoq$.jbWNa7gp5NIGSOpaCZuz0vvo.gOCwier5XtM.vBvBjIM3.vqOA0.Q9tQQiLeF3kGdset19/quynqKmyFGXBs/"
set system services ssh root-login allow
set system login user lab class super-user authentication encrypted-password "$6$0OeCYa28gJMGyhoq$.jbWNa7gp5NIGSOpaCZuz0vvo.gOCwier5XtM.vBvBjIM3.vqOA0.Q9tQQiLeF3kGdset19/quynqKmyFGXBs/"
set chassis fpc 0 lite-mode
set chassis network-services enhanced-ip
set groups MTU interfaces <ge-*> mtu 9192
set apply-groups MTU
delete interfaces fxp0 unit 0 family inet dhcp
set interfaces fxp0 unit 0 family inet address 192.168.90.29/24

# --- Loopback ---
set interfaces lo0 unit 0 family inet address 10.0.0.22/32
set interfaces lo0 unit 0 family mpls
set interfaces lo0 unit 0 family iso address 49.0001.0100.0000.0022.00

# --- Transit interfaces (inet + iso + mpls) ---
set interfaces ge-0/0/1 unit 0 family inet address 10.1.1.18/30
set interfaces ge-0/0/1 unit 0 family iso
set interfaces ge-0/0/1 unit 0 family mpls
set interfaces ge-0/0/2 unit 0 family inet address 10.1.1.21/30
set interfaces ge-0/0/2 unit 0 family iso
set interfaces ge-0/0/2 unit 0 family mpls
set interfaces ge-0/0/3 unit 0 family inet address 10.1.1.34/30
set interfaces ge-0/0/3 unit 0 family iso
set interfaces ge-0/0/3 unit 0 family mpls

# --- Routing options ---
set routing-options router-id 10.0.0.22
set routing-options autonomous-system 64512
set routing-options forwarding-table ecmp-fast-reroute
